<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- Automatic mode: calculates switch times automatically based on solar ephemeris -->
    <entry name="AutoSchedule" type="Bool">
      <label>Automatically calculate switch times from sunrise and sunset</label>
      <default>true</default>
    </entry>

    <!-- Manual schedule times for each time slot (in 24-hour format) -->
    <entry name="MorningHour" type="Int">
      <label>Morning start hour (0-23)</label>
      <default>6</default>
      <min>0</min>
      <max>23</max>
    </entry>
    <entry name="MorningMinute" type="Int">
      <label>Morning start minute (0-59)</label>
      <default>0</default>
      <min>0</min>
      <max>59</max>
    </entry>

    <entry name="NoonHour" type="Int">
      <label>Noon start hour (0-23)</label>
      <default>12</default>
      <min>0</min>
      <max>23</max>
    </entry>
    <entry name="NoonMinute" type="Int">
      <label>Noon start minute (0-59)</label>
      <default>0</default>
      <min>0</min>
      <max>59</max>
    </entry>

    <entry name="EveningHour" type="Int">
      <label>Evening start hour (0-23)</label>
      <default>18</default>
      <min>0</min>
      <max>23</max>
    </entry>
    <entry name="EveningMinute" type="Int">
      <label>Evening start minute (0-59)</label>
      <default>0</default>
      <min>0</min>
      <max>59</max>
    </entry>

    <entry name="NightHour" type="Int">
      <label>Night start hour (0-23)</label>
      <default>22</default>
      <min>0</min>
      <max>23</max>
    </entry>
    <entry name="NightMinute" type="Int">
      <label>Night start minute (0-59)</label>
      <default>0</default>
      <min>0</min>
      <max>59</max>
    </entry>

    <!-- Custom image file paths (empty string uses the bundled defaults) -->
    <entry name="MorningImage" type="String">
      <label>Custom morning image path</label>
      <default></default>
    </entry>
    <entry name="NoonImage" type="String">
      <label>Custom noon image path</label>
      <default></default>
    <entry name="EveningImage" type="String">
      <label>Custom evening image path</label>
      <default></default>
    </entry>
    <entry name="NightImage" type="String">
      <label>Custom night image path</label>
      <default></default>
    </entry>

    <!-- Enable dynamic accent color synchronization (disabled by default to preserve KDE system theme) -->
    <entry name="DynamicAccentColor" type="Bool">
      <label>Apply dynamic accent color from current wallpaper to KDE Plasma</label>
      <default>false</default>
    </entry>

    <!-- Custom accent colors per period (defaults matched to bundled wallpapers) -->
    <entry name="MorningColor" type="Color">
      <label>Accent color for morning period</label>
      <default>#f39c12</default>
    </entry>
    <entry name="NoonColor" type="Color">
      <label>Accent color for noon period</label>
      <default>#1d99f3</default>
    </entry>
    <entry name="EveningColor" type="Color">
      <label>Accent color for evening period</label>
      <default>#e67e22</default>
    </entry>
    <entry name="NightColor" type="Color">
      <label>Accent color for night period</label>
      <default>#6c5ce7</default>
    </entry>

    <!-- Transition settings -->
    <entry name="TransitionDuration" type="Int">
      <label>Crossfade transition duration in milliseconds</label>
      <default>1500</default>
      <min>0</min>
      <max>10000</max>
    </entry>

    <!-- Fill Mode: 1=Stretch, 2=PreserveAspectCrop, 3=PreserveAspectFit -->
    <entry name="FillMode" type="Int">
      <label>Image fill mode</label>
      <default>2</default>
    </entry>
  </group>
</kcfg>
